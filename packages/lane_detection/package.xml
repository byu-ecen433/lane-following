<?xml version="1.0"?>
<package format="2">
  <name>lane_detection</name>
  <version>0.0.0</version>
  <description>ECEN 433 Lab 4 - finding the lane markings in a camera image</description>

  <maintainer email="ecen433student@gmail.com">ECEN 433 Student</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Add a line here for every ROS package your nodes import from.
       cv_bridge is the one that converts between ROS images and OpenCV. -->
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>duckietown_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
  </export>
</package>
