<launch>

  <!--
    ECEN 433 - Lab 4, the detector on its own.

        test:=true    saved images, on your laptop, with debug windows
        test:=false   the live camera, on the robot
  -->

  <arg name="test" default="false"/>
  <arg name="ns" value="lane_detection_test" if="$(arg test)"/>
  <arg name="ns" value="$(optenv VEHICLE_NAME duckiebot)" unless="$(arg test)"/>

  <!-- Open a viewer per debug topic. On by default in test mode. -->
  <arg name="view" default="$(arg test)"/>

  <group ns="$(arg ns)">

    <!--
      The simulated camera feed.
    -->
    <node pkg="camera_sim" type="camera_sim_node.py" name="camera_node"
          output="screen" if="$(arg test)">
      <rosparam file="$(find camera_sim)/config/camera_sim.yaml" subst_value="true"/>
    </node>

    <node pkg="lane_detection" type="lane_detector_node.py" name="line_detector_node"
          output="screen">
      <rosparam file="$(find lane_detection)/config/$(arg ns).yaml" subst_value="true"/>
    </node>

    <group if="$(arg view)">
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_cropped"
            args="/$(arg ns)/line_detector_node/image_cropped"/>
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_edges"
            args="/$(arg ns)/line_detector_node/image_edges"/>
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_mask_white"
            args="/$(arg ns)/line_detector_node/mask_white"/>
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_mask_yellow"
            args="/$(arg ns)/line_detector_node/mask_yellow"/>
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_mask_red"
            args="/$(arg ns)/line_detector_node/mask_red"/>
      <node pkg="rqt_image_view" type="rqt_image_view" name="view_lines_all"
            args="/$(arg ns)/line_detector_node/image_lines_all"/>
    </group>

  </group>

</launch>
