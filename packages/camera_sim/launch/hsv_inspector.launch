<launch>

  <!--
    ECEN 433 - Lab 4. The live HSV picker.

        dts devel run -X -R <robot> -L inspect_hsv    # your robot's camera
        dts devel run -X -L inspect_hsv               # the sample images

    Same namespace trick as the detector: the topic name is relative, so `test`
    decides whether it reads camera_sim or the real camera.
  -->

  <arg name="test" default="false"/>
  <arg name="ns" value="lane_detection_test" if="$(arg test)"/>
  <arg name="ns" value="$(optenv VEHICLE_NAME duckiebot)" unless="$(arg test)"/>

  <arg name="image_topic" default="camera_node/image/compressed"/>

  <group ns="$(arg ns)">
    <node pkg="camera_sim" type="camera_sim_node.py" name="camera_node"
          output="screen" if="$(arg test)">
      <rosparam file="$(find camera_sim)/config/camera_sim.yaml" subst_value="true"/>
    </node>

    <node pkg="camera_sim" type="hsv_inspector.py" name="hsv_inspector" output="screen">
      <param name="image_topic" value="$(arg image_topic)"/>
    </node>
  </group>

</launch>
